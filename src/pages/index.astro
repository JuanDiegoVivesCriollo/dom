---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import TrustBar from '../components/TrustBar';
---

<Layout 
  title="DOM Transsport UK | Courier Services, Removals & End of Tenancy Cleaning Birmingham" 
  description="Professional courier services, same day courier, removals service and end of tenancy cleaning in Birmingham & West Midlands. Fully insured, DBS checked. Property cleaning across the UK. Call 07737 994071."
  canonical="/"
>
  <!-- Hero Section -->
  <Hero client:load />

  <!-- Trust Bar -->
  <TrustBar client:visible />

  <!-- Experience Section -->
  <section class="section-padding relative overflow-hidden bg-gray-50 dark:bg-[#0a1628] transition-colors duration-300">
    <!-- Background Decor -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-[var(--accent)]/5 rounded-full blur-3xl pointer-events-none transform translate-x-1/2 -translate-y-1/2"></div>

    <div class="container-custom relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Content -->
        <div class="space-y-8">
          <div>
            <span class="inline-block py-1 px-3 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-sm font-semibold tracking-wider uppercase mb-4 border border-[var(--accent)]/20">
              Experience & Industry Trust
            </span>
            <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6 leading-tight">
              Supporting <span class="text-gradient">UK Logistics & Property Networks</span>
            </h2>
            <p class="text-gray-600 dark:text-gray-400 text-lg leading-relaxed">
              With years of hands-on operational experience, Dom Transsport UK Ltd has 
              delivered reliability across structured delivery routes, removals, cleaning, and property support services.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white/50 dark:bg-white/5 border border-gray-200 dark:border-white/10 backdrop-blur-sm">
            <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-4">
              Trusted partner for recognised logistics networks including:
            </p>
            <div class="flex flex-wrap gap-x-6 gap-y-3 font-semibold text-gray-800 dark:text-white/90">
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                AIT
              </span>
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                XDP
              </span>
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Amazon
              </span>
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                DHL
              </span>
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Proovia
              </span>
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                End of Tenancy
              </span>
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Deep Cleaning
              </span>
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Post-Construction Cleaning
              </span>
            </div>
          </div>

          <a href="/about" class="btn-primary">
            Learn More About Us
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 gap-6">
          <div class="p-8 rounded-2xl bg-white dark:bg-[#152238] border border-gray-100 dark:border-[#1e3a5f] shadow-lg dark:shadow-none hover:border-[var(--accent)]/50 transition-all group">
            <h3 class="text-4xl font-bold text-[var(--accent)] mb-2 group-hover:scale-110 transition-transform origin-left">10+</h3>
            <p class="text-gray-600 dark:text-gray-400 font-medium">Years Experience</p>
          </div>
          <div class="p-8 rounded-2xl bg-white dark:bg-[#152238] border border-gray-100 dark:border-[#1e3a5f] shadow-lg dark:shadow-none hover:border-[var(--accent)]/50 transition-all group mt-8">
            <h3 class="text-4xl font-bold text-[var(--accent)] mb-2 group-hover:scale-110 transition-transform origin-left">1000+</h3>
            <p class="text-gray-600 dark:text-gray-400 font-medium">Successful Deliveries</p>
          </div>
          <div class="p-8 rounded-2xl bg-white dark:bg-[#152238] border border-gray-100 dark:border-[#1e3a5f] shadow-lg dark:shadow-none hover:border-[var(--accent)]/50 transition-all group">
            <h3 class="text-4xl font-bold text-[var(--accent)] mb-2 group-hover:scale-110 transition-transform origin-left">100%</h3>
            <p class="text-gray-600 dark:text-gray-400 font-medium">Fully Insured</p>
          </div>
          <div class="p-8 rounded-2xl bg-white dark:bg-[#152238] border border-gray-100 dark:border-[#1e3a5f] shadow-lg dark:shadow-none hover:border-[var(--accent)]/50 transition-all group mt-8">
            <h3 class="text-4xl font-bold text-[var(--accent)] mb-2 group-hover:scale-110 transition-transform origin-left">24/7</h3>
            <p class="text-gray-600 dark:text-gray-400 font-medium">Operational Capacity</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Preview Section -->
  <section class="section-padding bg-gray-50 dark:bg-gray-900 relative transition-colors duration-300">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block py-1 px-3 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-sm font-semibold tracking-wider uppercase mb-4 border border-[var(--accent)]/20">
          Our Services
        </span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
          Specialist Transsport & Property Services
        </h2>
        <p class="text-gray-600 dark:text-gray-400 text-lg">
          Comprehensive logistics and property services tailored to your specific requirements.
        </p>
      </div>

      <!-- Category: Transport & Logistics -->
      <div class="mb-16">
        <div class="flex items-center gap-4 mb-8">
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
            <span class="w-8 h-1 bg-[var(--accent)] rounded-full"></span>
            Transport & Logistics
          </h3>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Transport -->
          <a href="/services#transport" class="group bg-white dark:bg-[#1f2937] p-8 rounded-2xl shadow-sm hover:shadow-xl border border-gray-100 dark:border-gray-700 hover:border-[var(--accent)]/30 transition-all duration-300 hover:-translate-y-1">
            <div class="w-14 h-14 bg-[#0a1628] dark:bg-[#111827] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[var(--accent)] transition-colors duration-300">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
              </svg>
            </div>
            <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-3 group-hover:text-[var(--accent)] transition-colors">Transport & Logistics</h4>
            <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">Dedicated van services, scheduled rounds, nationwide routes.</p>
          </a>

          <!-- Medical -->
          <a href="/services#medical" class="group bg-white dark:bg-[#1f2937] p-8 rounded-2xl shadow-sm hover:shadow-xl border border-gray-100 dark:border-gray-700 hover:border-[var(--accent)]/30 transition-all duration-300 hover:-translate-y-1">
            <div class="w-14 h-14 bg-[#0a1628] dark:bg-[#111827] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[var(--accent)] transition-colors duration-300">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-3 group-hover:text-[var(--accent)] transition-colors">Medical Logistics</h4>
            <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">GP surgeries, pharmacy, and laboratory sample transport.</p>
          </a>

          <!-- Multi-Drop -->
          <a href="/services#courier" class="group bg-white dark:bg-[#1f2937] p-8 rounded-2xl shadow-sm hover:shadow-xl border border-gray-100 dark:border-gray-700 hover:border-[var(--accent)]/30 transition-all duration-300 hover:-translate-y-1">
            <div class="w-14 h-14 bg-[#0a1628] dark:bg-[#111827] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[var(--accent)] transition-colors duration-300">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
            <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-3 group-hover:text-[var(--accent)] transition-colors">Multi-Drop Courier</h4>
            <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">High-volume parcel routes with structured planning.</p>
          </a>

          <!-- Removals -->
          <a href="/services#removals" class="group bg-white dark:bg-[#1f2937] p-8 rounded-2xl shadow-sm hover:shadow-xl border border-gray-100 dark:border-gray-700 hover:border-[var(--accent)]/30 transition-all duration-300 hover:-translate-y-1">
            <div class="w-14 h-14 bg-[#0a1628] dark:bg-[#111827] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[var(--accent)] transition-colors duration-300">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            </div>
            <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-3 group-hover:text-[var(--accent)] transition-colors">Removals</h4>
            <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">Residential and commercial moves with two-man crews.</p>
          </a>
        </div>
      </div>

      <!-- Category: Property Division -->
      <div>
        <div class="flex items-center gap-4 mb-8">
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
            <span class="w-8 h-1 bg-[var(--accent)] rounded-full"></span>
            Property Division
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Cleaning -->
          <a href="/services#cleaning" class="group bg-white dark:bg-[#1f2937] p-8 rounded-2xl shadow-sm hover:shadow-xl border border-gray-100 dark:border-gray-700 hover:border-[var(--accent)]/30 transition-all duration-300 hover:-translate-y-1">
            <div class="w-14 h-14 bg-[#0a1628] dark:bg-[#111827] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[var(--accent)] transition-colors duration-300">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            </div>
            <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-3 group-hover:text-[var(--accent)] transition-colors">Cleaning Services</h4>
            <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">End of tenancy, Airbnb turnovers, and deep cleaning.</p>
          </a>

          <!-- Waste -->
          <a href="/services#waste" class="group bg-white dark:bg-[#1f2937] p-8 rounded-2xl shadow-sm hover:shadow-xl border border-gray-100 dark:border-gray-700 hover:border-[var(--accent)]/30 transition-all duration-300 hover:-translate-y-1">
            <div class="w-14 h-14 bg-[#0a1628] dark:bg-[#111827] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[var(--accent)] transition-colors duration-300">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </div>
            <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-3 group-hover:text-[var(--accent)] transition-colors">Waste & Clearance</h4>
            <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">Licensed waste carrier, responsible disposal services.</p>
          </a>

          <!-- CTA Card -->
          <a href="/contact" class="group bg-[var(--accent)] p-8 rounded-2xl shadow-lg hover:shadow-xl border border-[var(--accent)] hover:bg-[var(--accent-hover)] transition-all duration-300 hover:-translate-y-1 flex flex-col justify-center items-center text-center">
            <div class="w-14 h-14 bg-white/20 rounded-full flex items-center justify-center mb-6 text-white">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
            <h4 class="text-lg font-bold text-white mb-2">Need a Custom Quote?</h4>
            <p class="text-white/90 text-sm">Contact our team for a tailored solution.</p>
          </a>
        </div>
      </div>

      <div class="text-center mt-16">
        <a href="/services" class="inline-flex items-center gap-2 px-8 py-4 bg-white dark:bg-[#1f2937] text-gray-900 dark:text-white font-bold rounded-xl border border-gray-200 dark:border-gray-700 hover:border-[var(--accent)] hover:text-[var(--accent)] shadow-sm hover:shadow-lg transition-all duration-300">
          View Full Service Catalog
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Who We Work With Section -->
  <section class="section-padding bg-white dark:bg-[#0f1729] relative transition-colors duration-300">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-block py-1 px-3 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-sm font-semibold tracking-wider uppercase mb-4 border border-[var(--accent)]/20">
          Our Clients
        </span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
          Who We Work With
        </h2>
        <p class="text-gray-600 dark:text-gray-400 text-lg">
          We provide reliable services to a wide range of clients across the UK.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
        <div class="p-6 rounded-2xl bg-gray-50 dark:bg-[#152238] border border-gray-100 dark:border-[#1e3a5f] text-center hover:border-[var(--accent)]/50 transition-all group">
          <div class="w-12 h-12 bg-[var(--accent)]/10 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:bg-[var(--accent)]/20 transition-colors">
            <svg class="w-6 h-6 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          </div>
          <h4 class="font-bold text-gray-900 dark:text-white">Estate Agents</h4>
        </div>
        <div class="p-6 rounded-2xl bg-gray-50 dark:bg-[#152238] border border-gray-100 dark:border-[#1e3a5f] text-center hover:border-[var(--accent)]/50 transition-all group">
          <div class="w-12 h-12 bg-[var(--accent)]/10 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:bg-[var(--accent)]/20 transition-colors">
            <svg class="w-6 h-6 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          </div>
          <h4 class="font-bold text-gray-900 dark:text-white">Landlords & Tenants</h4>
        </div>
        <div class="p-6 rounded-2xl bg-gray-50 dark:bg-[#152238] border border-gray-100 dark:border-[#1e3a5f] text-center hover:border-[var(--accent)]/50 transition-all group">
          <div class="w-12 h-12 bg-[var(--accent)]/10 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:bg-[var(--accent)]/20 transition-colors">
            <svg class="w-6 h-6 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
          </div>
          <h4 class="font-bold text-gray-900 dark:text-white">Construction Companies</h4>
        </div>
        <div class="p-6 rounded-2xl bg-gray-50 dark:bg-[#152238] border border-gray-100 dark:border-[#1e3a5f] text-center hover:border-[var(--accent)]/50 transition-all group">
          <div class="w-12 h-12 bg-[var(--accent)]/10 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:bg-[var(--accent)]/20 transition-colors">
            <svg class="w-6 h-6 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h4 class="font-bold text-gray-900 dark:text-white">Logistics Networks</h4>
        </div>
        <div class="p-6 rounded-2xl bg-gray-50 dark:bg-[#152238] border border-gray-100 dark:border-[#1e3a5f] text-center hover:border-[var(--accent)]/50 transition-all group">
          <div class="w-12 h-12 bg-[var(--accent)]/10 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:bg-[var(--accent)]/20 transition-colors">
            <svg class="w-6 h-6 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          </div>
          <h4 class="font-bold text-gray-900 dark:text-white">Private Clients</h4>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Section -->
  <section class="section-padding bg-gray-50 dark:bg-gray-900 relative transition-colors duration-300">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-block py-1 px-3 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-sm font-semibold tracking-wider uppercase mb-4 border border-[var(--accent)]/20">
          Why Us
        </span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
          Why Choose DOM Transsport UK LTD?
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
