---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found" description="This page could not be found. Browse courier, removals and cleaning services in Birmingham." canonical="/404.html" noindex>
  <section class="section-padding container-custom text-center">
    <p class="text-[var(--accent)] mb-4">404</p>
    <h1 class="text-4xl mb-6">Page not found</h1>
    <p class="text-[var(--text-secondary)] mb-8">Find the courier, removals or cleaning service you need.</p>
    <a class="btn-primary" href="/">Return to the homepage</a>
  </section>
</Layout>
