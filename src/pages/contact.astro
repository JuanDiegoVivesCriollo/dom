---
import Layout from '../layouts/Layout.astro';
import ContactPage from '../components/ContactPage';
---

<Layout 
  title="Courier, Removals & Cleaning Quotes in Birmingham" 
  description="Request a quote for courier deliveries, removals or cleaning in Birmingham and the West Midlands. Call 07424 399563 or send your requirements online."
  canonical="/contact"
>
  <ContactPage client:load />
</Layout>

<style>
  /* Custom scrollbar styling for the contact page */
  :global(.contact-scroll::-webkit-scrollbar) {
    width: 6px;
  }
  
  :global(.contact-scroll::-webkit-scrollbar-track) {
    background: var(--bg-secondary);
    border-radius: 3px;
  }
  
  :global(.contact-scroll::-webkit-scrollbar-thumb) {
    background: var(--accent);
    border-radius: 3px;
  }
</style>
