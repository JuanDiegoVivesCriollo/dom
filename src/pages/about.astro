---
import Layout from '../layouts/Layout.astro';

const whyChooseUs = [
  {
    title: 'Two-Man Teams',
    description: 'Experienced crews for efficient and careful handling on every job, from removals to deep cleaning.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`,
  },
  {
    title: 'Uniformed Professionals',
    description: 'Professional presentation and conduct with company-branded uniforms and ID badges.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  },
  {
    title: 'Structured Scheduling',
    description: 'Planned routes and timetables for reliable, on-time service across transport and cleaning.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
  },
  {
    title: 'Clear Communication',
    description: 'Regular updates and transparent communication throughout every project.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />`,
  },
  {
    title: 'End-of-Tenancy Specialists',
    description: 'Deep cleaning and property preparation experts for landlords and estate agents.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />`,
  },
  {
    title: 'Consistent & Trusted',
    description: 'Building long-term relationships through dependable service every time.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />`,
  },
];

const stats = [
  { value: '10+', label: 'Years Combined Experience' },
  { value: '1000+', label: 'Successful Deliveries' },
  { value: '100%', label: 'Insurance Coverage' },
  { value: '7', label: 'Days a Week' },
];
---

<Layout 
  title="About Us | Trusted Courier & Cleaning Company Birmingham | DOM Transsport UK" 
  description="Experienced courier services and property cleaning company in Birmingham, West Midlands. DBS checked drivers, fully insured operations. Trusted by AIT, Amazon, DHL networks. UK-wide removals and end of tenancy cleaning."
  canonical="/about"
>
  <!-- Hero Section -->
  <section class="section-padding section-primary pt-32">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="badge mb-6">
            About Us
          </span>
          <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-6">
            Trusted Courier & Cleaning <span class="text-gradient">Company in Birmingham</span>
          </h1>
          <p class="text-theme-secondary text-lg leading-relaxed mb-6">
            With several years of hands-on operational experience, Dom Transport UK Ltd provides 
            professional logistics and cleaning services across the UK, combining efficient transport 
            operations with high-standard property care. From same-day deliveries and removals to 
            commercial and end-of-tenancy cleaning, we deliver structured, reliable solutions for 
            businesses and residential clients.
          </p>
          <p class="text-theme-secondary text-lg leading-relaxed">
            Based in Birmingham with nationwide coverage, we operate with professionalism, consistency and trust.
          </p>
        </div>
        <div class="relative">
          <div class="aspect-square rounded-2xl overflow-hidden">
            <img 
              src="/img/imgservices/aboutusimg.webp" 
              alt="Professional logistics team"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="absolute -bottom-6 -right-6 bg-[var(--accent)] rounded-xl p-6">
            <p class="text-white font-bold text-3xl">DBS</p>
            <p class="text-white/80 text-sm">Checked & Verified</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience Section -->
  <section id="experience" class="section-padding section-secondary overflow-hidden">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="badge mb-4">Our Network</span>
        <h2 class="text-3xl md:text-4xl font-bold text-theme-primary mb-4">Supporting UK Logistics & Property Networks</h2>
        <p class="text-theme-secondary text-lg">
          Our team supports recognised logistics networks alongside landlords, estate agents and property professionals, delivering reliable transport, removals and structured cleaning services with consistent operational standards.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 mb-16">
        <!-- Logistics Partners -->
        <div class="rounded-2xl p-5 md:p-8" style="background: linear-gradient(135deg, rgba(201,162,39,0.06), rgba(201,162,39,0.02)); border: 1px solid rgba(201,162,39,0.15);">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-[var(--accent)]/15 flex items-center justify-center">
              <svg class="w-5 h-5 text-theme-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-theme-primary">Logistics Partners</h3>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            <div class="theme-card rounded-xl p-4 text-center hover:border-[var(--accent)]/30 transition-all duration-300 hover:-translate-y-0.5">
              <span class="text-theme-accent font-bold text-xl block">AIT</span>
              <span class="text-theme-muted text-xs mt-1 block">AIT Logistics</span>
            </div>
            <div class="theme-card rounded-xl p-4 text-center hover:border-[var(--accent)]/30 transition-all duration-300 hover:-translate-y-0.5">
              <span class="text-theme-accent font-bold text-xl block">XDP</span>
              <span class="text-theme-muted text-xs mt-1 block">XDP Express</span>
            </div>
            <div class="theme-card rounded-xl p-4 text-center hover:border-[var(--accent)]/30 transition-all duration-300 hover:-translate-y-0.5">
              <span class="text-theme-accent font-bold text-xl block">AMZ</span>
              <span class="text-theme-muted text-xs mt-1 block">Amazon</span>
            </div>
            <div class="theme-card rounded-xl p-4 text-center hover:border-[var(--accent)]/30 transition-all duration-300 hover:-translate-y-0.5">
              <span class="text-theme-accent font-bold text-xl block">DHL</span>
              <span class="text-theme-muted text-xs mt-1 block">DHL Express</span>
            </div>
            <div class="theme-card rounded-xl p-4 text-center hover:border-[var(--accent)]/30 transition-all duration-300 hover:-translate-y-0.5">
              <span class="text-theme-accent font-bold text-xl block">PRO</span>
              <span class="text-theme-muted text-xs mt-1 block">Proovia</span>
            </div>
          </div>
        </div>

        <!-- Property Services -->
        <div class="rounded-2xl p-5 md:p-8" style="background: linear-gradient(135deg, rgba(16,185,129,0.06), rgba(16,185,129,0.02)); border: 1px solid rgba(16,185,129,0.15);">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-emerald-500/15 flex items-center justify-center">
              <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-theme-primary">Property Services</h3>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="theme-card rounded-xl p-4 text-center hover:border-emerald-500/30 transition-all duration-300 hover:-translate-y-0.5">
              <span class="text-emerald-500 font-bold text-xl block">EOT</span>
              <span class="text-theme-muted text-xs mt-1 block">End of Tenancy</span>
            </div>
            <div class="theme-card rounded-xl p-4 text-center hover:border-emerald-500/30 transition-all duration-300 hover:-translate-y-0.5">
              <span class="text-emerald-500 font-bold text-xl block">DPC</span>
              <span class="text-theme-muted text-xs mt-1 block">Deep Cleaning</span>
            </div>
            <div class="theme-card rounded-xl p-4 text-center hover:border-emerald-500/30 transition-all duration-300 hover:-translate-y-0.5">
              <span class="text-emerald-500 font-bold text-xl block">PCS</span>
              <span class="text-theme-muted text-xs mt-1 block">Property Cleaning</span>
            </div>
            <div class="theme-card rounded-xl p-4 text-center hover:border-emerald-500/30 transition-all duration-300 hover:-translate-y-0.5">
              <span class="text-emerald-500 font-bold text-xl block">PCC</span>
              <span class="text-theme-muted text-xs mt-1 block">Post-Construction</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {stats.map((stat) => (
          <div class="stat-box">
            <p class="text-theme-accent font-bold text-3xl md:text-4xl mb-2">{stat.value}</p>
            <p class="text-theme-secondary text-sm">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="section-padding section-primary">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-theme-primary mb-4">Why Choose DOM Transsport UK LTD?</h2>
        <p class="text-theme-secondary text-lg">
          We combine industry experience with a commitment to excellence in every job.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {whyChooseUs.map((item) => (
          <div class="flex items-start gap-6 service-card card-hover">
            <div class="w-14 h-14 bg-[var(--accent)]/10 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-7 h-7 text-theme-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon} />
            </div>
            <div>
              <h3 class="text-theme-primary font-semibold text-lg mb-2">{item.title}</h3>
              <p class="text-theme-secondary">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Client Experience Section -->
  <section class="section-padding section-secondary">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-8">
          <span class="badge mb-4">Client Experience</span>
          <h2 class="text-3xl md:text-4xl font-bold text-theme-primary">What Our Clients Value</h2>
        </div>
        <div class="theme-card rounded-2xl p-8 md:p-10 relative overflow-hidden" style="border-left: 4px solid var(--accent);">
          <!-- Quote icon -->
          <svg class="w-12 h-12 text-[var(--accent)]/20 mb-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983z" />
          </svg>
          <p class="text-theme-secondary text-lg md:text-xl leading-relaxed italic">
            Our clients appreciate our structured approach, reliability and professional communication. 
            Our experience supporting large logistics networks and property services reflects our 
            commitment to consistent, high-quality results.
          </p>
          <div class="mt-6 flex items-center gap-3">
            <div class="w-10 h-0.5 bg-[var(--accent)]"></div>
            <span class="text-theme-accent font-semibold text-sm">DOM Transsport UK LTD</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="section-padding section-primary">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="rounded-2xl overflow-hidden" style="border: 1px solid rgba(201,162,39,0.15);">
          <!-- Accent top bar -->
          <div class="h-1.5" style="background: linear-gradient(90deg, var(--accent), #e6c94d, var(--accent));"></div>
          <div class="p-8 md:p-12 theme-card border-0">
            <div class="text-center">
              <div class="w-16 h-16 rounded-2xl bg-[var(--accent)]/10 flex items-center justify-center mx-auto mb-6">
                <svg class="w-8 h-8 text-theme-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h2 class="text-3xl md:text-4xl font-bold text-theme-primary mb-6">Our Mission</h2>
              <p class="text-theme-secondary text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
                We are committed to delivering reliable, efficient and professional transport and property 
                services. Every project is handled with care, consistency and attention to detail, because 
                our reputation is built on every interaction.
              </p>
              <div class="flex flex-wrap justify-center gap-3">
                <span class="px-5 py-2.5 bg-[var(--accent)]/10 text-theme-accent rounded-full text-sm font-semibold">Reliable</span>
                <span class="px-5 py-2.5 bg-[var(--accent)]/10 text-theme-accent rounded-full text-sm font-semibold">Structured</span>
                <span class="px-5 py-2.5 bg-[var(--accent)]/10 text-theme-accent rounded-full text-sm font-semibold">Professional</span>
                <span class="px-5 py-2.5 bg-[var(--accent)]/10 text-theme-accent rounded-full text-sm font-semibold">Consistent</span>
                <span class="px-5 py-2.5 bg-[var(--accent)]/10 text-theme-accent rounded-full text-sm font-semibold">Trust</span>
              </div>
            </div>
            
            <!-- Faith-based statement (discreet) -->
            <div class="mt-12 pt-8 border-t border-theme text-center">
              <p class="text-theme-muted text-sm italic">
                "All honour and glory to God, who guides our work, our values and our purpose."
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding section-secondary">
    <div class="container-custom text-center">
      <h2 class="text-3xl font-bold text-theme-primary mb-4">Ready to Work With Us?</h2>
      <p class="text-theme-secondary text-lg mb-8 max-w-2xl mx-auto">
        Get in touch today for a free quote on any of our services.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn-primary">
          Contact Us
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="tel:+447424399563" class="btn-secondary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call Now
        </a>
      </div>
    </div>
  </section>
</Layout>
